# Base URL of the TrendLens Node.js backend, e.g. the Servarica VPS or local dev.
# Used by server-side code. For browser-side fetches also set NEXT_PUBLIC_ADMIN_API_URL
# to the same value (browsers cannot read non-public env vars).
ADMIN_API_URL=http://localhost:3000

# Optional but recommended: same value as ADMIN_API_URL, exposed to the browser.
# Required because adminFetch runs client-side.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000

# MUST equal the backend's ADMIN_KEY (server/.env). Compared in the login page.
NEXT_PUBLIC_ADMIN_KEY=change-me-to-a-long-random-secret
