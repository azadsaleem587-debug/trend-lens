# Port the server listens on
PORT=3000

# Where user uploads are stored on disk (served at /uploads)
UPLOAD_DIR=./uploads

# Where proxied AI images are cached on disk
AI_CACHE_DIR=./cache/ai

# Secret value for the x-admin-key header (admin API). CHANGE THIS.
ADMIN_KEY=change-me-to-a-long-random-secret

# Max single-file upload size in megabytes
MAX_UPLOAD_MB=100

# AI image generations allowed per hour, per IP
RATE_LIMIT_PER_HOUR=20
